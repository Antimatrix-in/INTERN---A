# ANTI-MATRIX Environment Configuration Template
SECRET_KEY=generate-a-strong-random-key
FLASK_APP=app.py
FLASK_ENV=development
FLASK_DEBUG=1

# Database Configuration
# Local development uses SQLite3 by default (stored at instance/anti_matrix.db).
# For Hostinger VPS production (PostgreSQL), configure DATABASE_URL:
# DATABASE_URL=postgresql://username:password@hostname:5432/anti_matrix_db

# Security & Expiry Settings
CREDENTIAL_EXPIRY_HOURS=48
MAX_CONTENT_LENGTH=5242880

# Initial Admin Credentials (used by CLI seed command)
ADMIN_USERNAME=admin
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=ChangeThisPassword123!
ADMIN_FULL_NAME=Platform Administrator
