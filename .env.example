# ANTI-MATRIX Environment Configuration Template
SECRET_KEY=generate-a-strong-random-key
FLASK_APP=app.py
FLASK_ENV=development
FLASK_DEBUG=1

# Primary Assessment Database (Destination)
# Local development uses SQLite3 by default (stored at instance/anti_matrix.db).
# For Hostinger VPS production (PostgreSQL):
# ASSESSMENT_DATABASE_URL=postgresql://anti_matrix_assessment_user:password@127.0.0.1:5432/anti_matrix_assessment_db

# Authoritative Candidate Source Database (Strict Read-Only)
# Dedicated restricted read-only account connecting to main website antimatrix_db
# ANTIMATRIX_READONLY_DATABASE_URL=postgresql://antimatrix_readonly:password@127.0.0.1:5432/antimatrix_db

# Security & Expiry Settings
CREDENTIAL_EXPIRY_HOURS=48
MAX_CONTENT_LENGTH=5242880

# Initial Admin Credentials (used by CLI seed command)
ADMIN_USERNAME=admin
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=ChangeThisPassword123!
ADMIN_FULL_NAME=Platform Administrator
